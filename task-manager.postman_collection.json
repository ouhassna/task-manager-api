{
  "info": {
    "name": "Task Manager API",
    "description": "Secure REST API built with Next.js, Prisma, and JWT authentication. Includes a dedicated folder proving the IDOR (Insecure Direct Object Reference) protection: User A is blocked from accessing/modifying User B's tasks even when they know or guess the task ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "tokenUserB", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "taskIdUserB", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Creates a new user account. Password is hashed with bcrypt before storage - never stored in plain text."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) {",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in and returns a JWT (1 hour expiry). Automatically saves the token to the {{token}} collection variable via the post-response script, so subsequent requests in this collection work without manual copy-pasting."
          }
        },
        {
          "name": "Login - Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Expected: 401 'Invalid email or password'. This is deliberately the SAME message returned for a non-existent email, preventing user enumeration."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) {",
                  "    pm.collectionVariables.set('taskId', data.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write README\",\n  \"description\": \"Document the API endpoints\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Creates a task tied to the authenticated user. userId is derived entirely from the verified JWT - never trusted from the request body. Saves the new task's id to {{taskId}}."
          }
        },
        {
          "name": "List My Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Returns ONLY tasks belonging to the authenticated user (filtered at the database query level via where: { userId })."
          }
        },
        {
          "name": "Update My Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Expected: 200. Updates a task you actually own."
          }
        },
        {
          "name": "Delete My Task",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Expected: 200. Deletes a task you actually own."
          }
        },
        {
          "name": "Create Task - No Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"description\": \"no token provided\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Expected: 401 'Missing or invalid authorization header'."
          }
        }
      ]
    },
    {
      "name": "Security Test - IDOR",
      "description": "Proves the core security claim of this project: a logged-in user (User A) cannot access, modify, or delete another user's (User B's) tasks - even with a fully valid token - by guessing or knowing the task ID. Run these requests in order.",
      "item": [
        {
          "name": "1. Register User B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User B\",\n  \"email\": \"userb@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) {",
                  "    pm.collectionVariables.set('tokenUserB', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"userb@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Saves User B's token to {{tokenUserB}}."
          }
        },
        {
          "name": "3. Create Task as User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) {",
                  "    pm.collectionVariables.set('taskIdUserB', data.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenUserB}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"User B secret task\",\n  \"description\": \"Should never be visible or editable by User A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Saves this task's id to {{taskIdUserB}} for the attack attempts below."
          }
        },
        {
          "name": "4. User A - List Tasks (should NOT include User B's task)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Expected: 200, list contains only User A's own tasks. 'User B secret task' must NOT appear here."
          }
        },
        {
          "name": "5. ATTACK: User A tries to UPDATE User B's task (expect 403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hacked by User A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskIdUserB}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskIdUserB}}"]
            },
            "description": "THIS IS THE CORE IDOR TEST. User A holds a fully valid JWT but does not own this task. Expected: 403 'You do not have permission to modify this task'. If this returns 200, the ownership check is broken."
          }
        },
        {
          "name": "6. ATTACK: User A tries to DELETE User B's task (expect 403)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskIdUserB}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskIdUserB}}"]
            },
            "description": "Expected: 403 'You do not have permission to delete this task'."
          }
        }
      ]
    }
  ]
}
